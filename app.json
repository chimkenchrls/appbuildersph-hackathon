{
  "expo": {
    "name": "OwlSet",
    "slug": "diligent-dev",
    "scheme": "diligent-dev",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diligentdev.app"
    },
    "android": {
      "package": "com.saklaw.dds"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "llama.rn",
      "@react-native-vector-icons/lucide",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9284596-ad69-4623-812b-67cf09bf51f7"
      }
    }
  }
}
