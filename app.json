{
  "expo": {
    "name": "OwlSet",
    "slug": "owlset",
    "scheme": "owlset",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.owlset.app"
    },
    "android": {
      "package": "com.owlset.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-sharing"
    ]
  }
}
