{
  "expo": {
    "name": "OwlSet",
    "slug": "owlset",
    "scheme": "owlset",
    "version": "1.0.0",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.owlset.app"
    },
    "android": {
      "package": "com.owlset.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "llama.rn",
      "@react-native-vector-icons/lucide",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a9872c8-9c3b-4ccf-885e-7f5116233f8c"
      }
    },
    "owner": "twilightdust"
  }
}
