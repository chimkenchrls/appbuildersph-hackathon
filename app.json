{
  "expo": {
    "name": "Diligent Dev",
    "slug": "diligent-dev",
    "scheme": "diligent-dev",
    "version": "1.0.0",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diligentdev.app"
    },
    "android": {
      "package": "com.diligentdev.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-sharing"
    ]
  }
}
