# ==============================================================================
# OwlSet - Local Development Environment Variables Template
# ==============================================================================
#
# NOTE: OwlSet is an offline-first application. All core features work without
# internet access or external cloud services.
#
# These variables are optional for local development and testing with LM Studio.
# In Expo, any variable prefixed with EXPO_PUBLIC_ is embedded directly into the
# client app bundle. NEVER put private keys, secrets, or passwords here.
#
# To customize these defaults:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Adjust values as needed for your local machine or network setup.
# ==============================================================================

# Local LM Studio inference server base URL
# - Android Emulator: http://10.0.2.2:1234/v1
# - iOS Simulator / Web: http://127.0.0.1:1234/v1
# - Physical phone on local Wi-Fi: http://<YOUR_COMPUTER_LAN_IP>:1234/v1
EXPO_PUBLIC_LM_STUDIO_URL=http://10.0.2.2:1234/v1

# Target model identifier loaded in LM Studio
EXPO_PUBLIC_LM_STUDIO_MODEL=local-model

# Set to 1 to run the mobile screens on labeled in-memory demo data and prepared AI
# output instead of SQLite and the local model. Leave unset for normal use.
# EXPO_PUBLIC_SAKLAW_FIXTURES=1
