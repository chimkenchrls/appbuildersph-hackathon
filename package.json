{
  "name": "diligent-dev",
  "version": "1.0.0",
  "private": true,
  "description": "Hackathon starter for web, Android, and iOS",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --web",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "check:dependencies": "expo install --check"
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
